@page "/VerFacturas"
@inject HttpClient httpClient
@inject NavigationManager navigation
@inject NotificationService notificationServices

<PageTitle>Ver Facturas</PageTitle>
<RadzenNotification />

<div class="header">
    <button class="btn-back" @onclick="goBack">
        <i class="bi bi-arrow-left"></i>
    </button>
    <h1 class="title">Ver factura</h1>
    <select class="filter-dropdown" @onchange="FilterFacturas">
        <option value="todas">Todas</option>
        <option value="pendientes">Pendientes</option>
        <option value="pagadas">Pagadas</option>
    </select>
</div>
<div class="container-fondo">
    <div class="facturas-container">
        @if (facturasFiltradas == null || facturasFiltradas.Count == 0)
        {
            <div class="mensaje">@mensaje</div>
        }
        else
        {
            @foreach (var factura in facturasFiltradas)
            {
                <div class="factura-item">
                    <i class="bi @(factura.Deuda > 0 ? "bi-exclamation-circle text-danger" : "bi-check-circle text-success") icon"></i>
                    <div class="factura-info">
                        <span class="factura-id">@factura.FacturaId - @factura.NombreCliente</span>
                        <span class="factura-num">#@factura.FacturaId.ToString("D2")</span>

                        @if (factura.Deuda > 0)
                        {
                            <span class="factura-deuda">💰 Deuda: @factura.Deuda.ToString("C")</span>

                            <!-- Botón para abrir el modal de abonar -->
                            <button class="btn-abonar" @onclick="() => OpenAbonarModal(factura.FacturaId)">Abonar</button>
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>

<!-- Modal para ingresar el monto de abono -->
@if (isAbonarModalVisible)
{
    <div class="modal-overlay" @onclick="CloseAbonarModal">
        <div class="modal-box" @onclick:stopPropagation="true">
            <div class="modal-content">
                <h3>Abonar a la Factura #@facturaSeleccionadaId</h3>
                <input type="number" min="0.01" step="0.01" @bind="montoAbono" placeholder="Ingrese el monto" class="input-abonar" />
                <button class="btn-confirmar-abono" @onclick="ConfirmarAbono">Confirmar</button>
            </div>
        </div>
    </div>
}



<button class="info-button" @onclick="ShowModal"><i class="bi bi-info-circle" /></button>

@if (isModalVisible)
{
    <div class="modal-overlay" @onclick="CloseModal">
        <div class="modal-box" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-body">
                    <div class="modal-option">
                        <i class="bi-check-circle text-success"></i>
                        <span>Cuentas terminadas</span>
                    </div>
                    <div class="modal-option">
                        <i class="bi-exclamation-circle text-danger"></i>
                        <span>Cuentas por Cobrar</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    public List<Factura>? facturas { get; set; }
    public List<Factura>? facturasFiltradas { get; set; }
    public string mensaje = "";
    private bool isModalVisible = false;
    private string filtroSeleccionado = "todas";
    private int facturaSeleccionadaId;
    private bool isAbonarModalVisible = false;
    private float montoAbono = 0;

    private async Task AbonarFactura(int facturaId, float monto)
    {
        var factura = facturas.FirstOrDefault(f => f.FacturaId == facturaId);
        if (factura != null && monto > 0)
        {
            factura.Pagado += monto; // Actualiza localmente el monto pagado

            // Enviar PUT al servidor para actualizar el monto pagado
            var response = await httpClient.PutAsJsonAsync($"api/Facturas/{facturaId}/abonar", factura);
            if (response.IsSuccessStatusCode)
            {
                facturasFiltradas = facturas.Where(f => filtroSeleccionado == "pendientes" ? f.Deuda > 0 : true).ToList();
                var Mensaje1 = new NotificationMessage
                    {
                        Severity = NotificationSeverity.Success,
                        Summary = "Guardado",
                        Detail = $"Se abonó {monto:C} a la factura #{facturaId}.",
                        Duration = 1000
                    };
                notificationServices.Notify(Mensaje1);
                await Task.Delay(1000);
            }
            else
            {
                var Mensaje1 = new NotificationMessage
                    {
                        Severity = NotificationSeverity.Success,
                        Summary = "Guardado",
                        Detail = "No se pudo procesar el abono.",
                        Duration = 1000
                    };
                notificationServices.Notify(Mensaje1);
                await Task.Delay(1000);
            }
        }
    }

    private void OpenAbonarModal(int facturaId)
    {
        facturaSeleccionadaId = facturaId;
        montoAbono = 0;
        isAbonarModalVisible = true;
    }

    private void CloseAbonarModal()
    {
        isAbonarModalVisible = false;
    }

    private async Task ConfirmarAbono()
    {
        if (montoAbono > 0)
        {
            await AbonarFactura(facturaSeleccionadaId, montoAbono);
            CloseAbonarModal();
        }
        else
        {
        }
    }

    protected override async Task OnInitializedAsync()
    {
        facturas = await httpClient.GetFromJsonAsync<List<Factura>>("api/Facturas");

        if (facturas == null || facturas.Count == 0)
        {
            mensaje = "No hay facturas disponibles.";
            await Task.Delay(3000);
        }
        else
        {
            facturasFiltradas = new List<Factura>(facturas); // Inicializa con todas
        }
    }

    private void FilterFacturas(ChangeEventArgs e)
    {
        filtroSeleccionado = e.Value.ToString();

        if (facturas != null)
        {
            if (filtroSeleccionado == "pendientes")
            {
                facturasFiltradas = facturas.Where(f => f.Deuda > 0).ToList();
            }
            else if (filtroSeleccionado == "pagadas")
            {
                facturasFiltradas = facturas.Where(f => f.Deuda == 0).ToList();

            }
            else
            {
                facturasFiltradas = new List<Factura>(facturas);
            }
        }
    }
    private async Task CobrarFactura(int facturaId)
    {
        var factura = facturas.FirstOrDefault(f => f.FacturaId == facturaId);
        if (factura != null)
        {
            factura.Pagado = factura.Total; // Marca como pagado
            facturasFiltradas = facturas.Where(f => filtroSeleccionado == "pendientes" ? f.Deuda > 0 : true).ToList();
            var Mensaje1 = new NotificationMessage
                {
                    Severity = NotificationSeverity.Success,
                    Summary = "Guardado",
                    Detail = $"La factura #{facturaId} ha sido cobrada.",
                    Duration = 1000
                };
            notificationServices.Notify(Mensaje1);
            await Task.Delay(1000);
        }
    }

    private void ShowModal()
    {
        isModalVisible = true;
    }

    private void CloseModal()
    {
        isModalVisible = false;
    }

    private void goBack()
    {
        navigation.NavigateTo("/");
    }
}
