@page "/VerFacturas"
@inject HttpClient httpClient
@inject NavigationManager navigation
@inject NotificationService notificationServices

<PageTitle>Ver Facturas</PageTitle>
<RadzenNotification />

<div class="header">
    <button class="btn-back" @onclick="goBack">
        <i class="bi bi-arrow-left"></i>
    </button>
    <h1 class="title">Ver factura</h1>
    <select class="filter-dropdown" @onchange="FilterFacturas">
        <option value="todas">Todas</option>
        <option value="pendientes">Pendientes</option>
        <option value="pagadas">Pagadas</option>
    </select>
</div>
<div class="container-fondo">
    <div class="facturas-container">
        @if (facturasFiltradas == null || facturasFiltradas.Count == 0)
        {
            <div class="mensaje">@mensaje</div>
        }
        else
        {
            @foreach (var factura in facturasFiltradas)
            {
                <div class="factura-item" @onclick="() => MostrarFacturaDetalles(factura)">
                    <i class="bi @(factura.Deuda > 0 ? "bi-exclamation-circle text-danger" : "bi-check-circle text-success") icon"></i>
                    <div class="factura-info">
                        <span class="factura-id">@factura.FacturaId - @factura.NombreCliente</span>
                        <span class="factura-num">#@factura.FacturaId.ToString("D2")</span>

                        @if (factura.Deuda > 0)
                        {
                            <span class="factura-deuda">💰 Deuda: @factura.Deuda.ToString("C")</span>
                            <button class="btn-abonar" @onclick="() => OpenAbonarModal(factura.FacturaId)">Abonar</button>
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>

<!-- Modal para abonar -->
@if (isAbonarModalVisible)
{
    <div class="modal-overlay" @onclick="CloseAbonarModal">
        <div class="modal-box" @onclick:stopPropagation="true">
            <div class="modal-content">
                <h3>Abonar a la Factura #@facturaSeleccionadaId</h3>
                <input type="number" min="0.01" step="0.01" @bind="montoAbono" placeholder="Ingrese el monto" class="input-abonar" />
                <button class="btn-confirmar-abono" @onclick="ConfirmarAbono">Confirmar</button>
            </div>
        </div>
    </div>
}

<!-- Modal de detalles de la factura -->
@if (isFacturaDetallesVisible)
{
    <div class="modal-overlay" @onclick="CloseFacturaDetalles">
        <div class="modal-box" @onclick:stopPropagation="true">
            <div class="modal-content factura-detalles">
                <div class="factura-header">
                    <h2>RETROGRAF</h2>
                    <p>Librería, Personalización y Diseños</p>
                    <p>Dirección: C/ Juan Bosch #19A, Vista al Valle</p>
                    <p>San Fco de Macorís</p>
                    <p>829-771-9987</p>
                </div>  

                <hr>

                <div class="factura-info">
                    <p><strong>Fecha:</strong> @facturaSeleccionada.Fecha</p>
                    <p><strong>Código:</strong> @facturaSeleccionada.CodigoCliente"</p>
                    <p><strong># Factura:</strong> @facturaSeleccionada.FacturaId</p>
                    <p><strong>Cliente:</strong> @facturaSeleccionada.NombreCliente</p>
                    <p><strong>Pago con:</strong> Efectivo</p>
                </div>
                <hr>

                <!-- Tabla de productos -->
                <table class="factura-tabla">
                    <thead>
                        <tr>
                            <th>Cant</th>
                            <th>Producto</th>
                            <th>Precio</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var detalle in facturaSeleccionada.Detalles)
                        {
                            <tr>
                                <td>@detalle.Cantidad</td>
                                <td>@detalle.NombreProducto</td>
                                <td>@detalle.PrecioUnitario</td>
                                <td>@(detalle.Cantidad * detalle.PrecioUnitario)</td>
                            </tr>
                        }
                    </tbody>
                </table>

                <hr>

                <div class="factura-total">
                    <p><strong>Deuda:</strong> @facturaSeleccionada.Deuda.ToString("C")</p>
                    <p><strong>Total:</strong> @facturaSeleccionada.Total.ToString("C")</p>
                </div>
            </div>
        </div>
    </div>
}

@code {
    public List<Factura>? facturas { get; set; }
    public List<Factura>? facturasFiltradas { get; set; }
    public Factura facturaSeleccionada { get; set; }
    public string mensaje = "";
    private bool isFacturaDetallesVisible = false;
    private bool isAbonarModalVisible = false;
    private string filtroSeleccionado = "todas";
    private int facturaSeleccionadaId;
    private float montoAbono = 0;

    private async Task AbonarFactura(int facturaId, float monto)
    {
        var factura = facturas.FirstOrDefault(f => f.FacturaId == facturaId);
        if (factura != null && monto > 0)
        {
            factura.Pagado += monto;

            var response = await httpClient.PutAsJsonAsync($"api/Facturas/{facturaId}", factura);
            if (response.IsSuccessStatusCode)
            {
                facturasFiltradas = facturas.Where(f => filtroSeleccionado == "pendientes" ? f.Deuda > 0 : true).ToList();
                notificationServices.Notify(new NotificationMessage
                    {
                        Severity = NotificationSeverity.Success,
                        Summary = "Guardado",
                        Detail = $"Se abonó {monto:C} a la factura #{facturaId}.",
                        Duration = 1000
                    });
            }
            else
            {
                notificationServices.Notify(new NotificationMessage
                    {
                        Severity = NotificationSeverity.Error,
                        Summary = "Error",
                        Detail = "No se pudo procesar el abono.",
                        Duration = 1000
                    });
            }
        }
    }

    private void OpenAbonarModal(int facturaId)
    {
        facturaSeleccionadaId = facturaId;
        montoAbono = 0;
        isAbonarModalVisible = true;
    }

    private void CloseAbonarModal()
    {
        isAbonarModalVisible = false;
    }

    private async Task ConfirmarAbono()
    {
        if (montoAbono > 0)
        {
            await AbonarFactura(facturaSeleccionadaId, montoAbono);
            CloseAbonarModal();
        }
    }

    private void MostrarFacturaDetalles(Factura factura)
    {
        facturaSeleccionada = factura;
        isFacturaDetallesVisible = true;
    }

    private void CloseFacturaDetalles()
    {
        isFacturaDetallesVisible = false;
    }

    protected override async Task OnInitializedAsync()
    {
        facturas = await httpClient.GetFromJsonAsync<List<Factura>>("api/Facturas");
        facturasFiltradas = facturas ?? new List<Factura>();
    }

    private void FilterFacturas(ChangeEventArgs e)
    {
        filtroSeleccionado = e.Value.ToString();
        facturasFiltradas = facturas?.Where(f =>
            filtroSeleccionado == "pendientes" ? f.Deuda > 0 :
            filtroSeleccionado == "pagadas" ? f.Deuda == 0 : true).ToList();
    }

    private void goBack()
    {
        navigation.NavigateTo("/");
    }
}
